# Basis-Image gemaess offizieller Connect-API-Dokumentation (Beispielkapitel):
# https://github.com/homematicip/connect-api
FROM --platform=linux/arm64 ghcr.io/homematicip/alpine-node-simple:0.0.1

WORKDIR /app

COPY package*.json ./
# node_modules wird VOR dem Bau ausserhalb installiert (npm ci --omit=dev)
# und hier nur kopiert. Alle Abhaengigkeiten (express, ws, uuid) sind reines
# JavaScript ohne native Module - ein npm install unter ARM-Emulation ist so
# nicht noetig (das hing in GitHub Actions gelegentlich).
COPY node_modules ./node_modules

COPY src ./src
COPY public ./public

# Web-Oberflaeche des Plugins - wird von der HCU direkt nach aussen durchgereicht
EXPOSE 8099

ENTRYPOINT ["node", "src/plugin.js"]

# Plugin-Metadaten (Pflichtlabel laut Doku-Kapitel "Containerization")
# pluginId/issuer/friendlyName/description bei Bedarf anpassen.
LABEL de.eq3.hmip.plugin.metadata=\
'{\
"pluginId": "io.github.ollo18.wrc6led",\
"issuer": "OllO18",\
"version": "1.0.0",\
"hcuMinVersion": "1.4.7",\
"scope": "LOCAL",\
"friendlyName": {\
"en": "WRC6 LED Control",\
"de": "WRC6 LED-Steuerung"\
},\
"description": {\
"en": "Lets the LEDs of the HmIP-WRC6-230 wall switch show what is going on: open windows, motion, smoke, water, temperature, power consumption and more. Set up in its own web interface.",\
"de": "L\u00e4sst die LEDs des Wandtasters HmIP-WRC6-230 anzeigen, was im Haus los ist: offene Fenster, Bewegung, Rauch, Wasser, Temperatur, Stromverbrauch und mehr. Einrichtung \u00fcber eine eigene Weboberfl\u00e4che."\
},\
"settings": [],\
"image": "",\
"logsEnabled": true\
}'
